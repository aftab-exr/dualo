# Database: Use your production Postgres URL (Supabase, Neon, Render, Railway, etc.)
# Both postgres:// and postgresql+asyncpg:// are supported
DATABASE_URL=postgresql+asyncpg://dualo_user:dualo_password@localhost:5432/dualo_db

# Redis: Upstash / Redis Cloud / Managed Redis
REDIS_URL=redis://localhost:6379/0

# Google OAuth: Web Client ID from Firebase / Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Security: Generate a random 32-byte hex string (e.g. `openssl rand -hex 32`)
SECRET_KEY=your_production_secret_key_change_me

# CORS: Comma-separated list of allowed frontend domains
ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:5173,capacitor://localhost

